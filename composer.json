{
    "name": "ptpn/ion-client",
    "description": "Official PHP/Laravel client for ION SSO API",
    "type": "library",
    "keywords": [
        "ion",
        "sso",
        "laravel",
        "client",
        "sdk",
        "ptpn",
        "authentication"
    ],
    "homepage": "https://github.com/ptpn/ion-client",
    "license": "MIT",
    "authors": [
        {
            "name": "PTPN",
            "email": "dev@palmco.id",
            "homepage": "https://palmco.id"
        }
    ],
    "support": {
        "issues": "https://github.com/ptpn/ion-client/issues",
        "source": "https://github.com/ptpn/ion-client"
    },
    "require": {
        "php": "^7.3|^8.0",
        "guzzlehttp/guzzle": "^6.5|^7.0",
        "illuminate/http": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0|^10.0|^11.0",
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "Ptpn\\IonClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ptpn\\IonClient\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ptpn\\IonClient\\IonClientServiceProvider"
            ],
            "aliases": {
                "IonClient": "Ptpn\\IonClient\\Facades\\IonClient"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
